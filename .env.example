# AnyRouter 账号配置
#
# 邮箱密码登录（推荐）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]
#
# Session 登录（兼容旧版）:
# ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]
# 新版 Bearer token 登录（部分 NewAPI 站点已切换到 access_token）:
# ANYROUTER_ACCOUNTS=[{"access_token":"你的 access_token"}]
#
# 混合配置（邮箱密码优先，session 作为备选）:
# ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

ANYROUTER_ACCOUNTS=[{"email":"your@email.com","password":"your_password","api_user":"你的api_user值"}]

# 追加账号（格式同上）。加载顺序 ANYROUTER_ACCOUNTS -> EXTRA_ACCOUNTS -> EXTRA_ACCOUNTS_2 -> EXTRA_ACCOUNTS_3，
# 合并成一份列表；同名账号后者覆盖前者。分多个变量是因为 GitHub Secret 写入后读不出来，
# 新站点单独占一个编号才不会在改动时覆盖掉已有账号。
# EXTRA_ACCOUNTS=[{"name":"小鸡毛","provider":"xiaojimao","access_token":"xxx"}]
# EXTRA_ACCOUNTS_2=[{"name":"FuturePPO-Dodo","provider":"futureppo","cookies":{"session":"xxx"},"api_user":"2806"}]
# Twinkle Model（Sub2API，推荐邮箱密码登录，每次任务自动换取短效 token）:
# EXTRA_ACCOUNTS_3=[{"name":"Twinkle-Dodo","provider":"twinkle","email":"you@example.com","password":"your_password"}]
# 也可以只保存 refresh_token：
# EXTRA_ACCOUNTS_3=[{"name":"Twinkle-Dodo","provider":"twinkle","refresh_token":"xxx"}]
# 42 API（https://api.42w.shop，NewAPI）：
# EXTRA_ACCOUNTS_5=[{"name":"42-Dodo","provider":"42w","cookies":{"session":"xxx"},"api_user":"你的用户ID"}]
# Kapibala（https://kapibala.asia，新版 NewAPI Bearer 认证）：
# EXTRA_ACCOUNTS_6=[{"name":"Kapibala-Dodo","provider":"kapibala","cookies":{"new_api_refresh":"xxx","session":"xxx"}}]
# CUN（https://www.cun.ai）：
# EXTRA_ACCOUNTS_7=[{"name":"CUN-Dodo","provider":"cun","username":"your_username","password":"your_password"}]

# 调试模式：true 时保存登录截图、输出代理地址/api_user 等详细日志（默认 false）
# DEBUG_MODE=false
# CHECKIN_BROWSER_PROFILE_DIR=.browser_profiles
# CLOAKBROWSER_BINARY_PATH=/path/to/local/browser

# 可选：Clash/Mihomo 订阅（CI 配 GitHub Secret PROXY_SUBSCRIPTION_URL；本地可先运行 scripts/setup_mihomo_proxy.sh）
# PROXY_SUBSCRIPTION_URL=https://example.com/sub?token=xxx
# CHECKIN_PROXY_URL=http://127.0.0.1:7890
# PROVIDERS 可按平台配置 use_proxy（内置默认 anyrouter=false, agentrouter=true）
# PROVIDERS={"agentrouter":{"domain":"https://agentrouter.org","use_proxy":true}}

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
# BARK_KEY=your_bark_key
# BARK_SERVER=https://api.day.app
